{
  "description": "Goal-loop hooks: bracket every agent START/END into harness.events; keep MAIN going while the goal is unfinished",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/scripts/goal-git.sh harness hook",
            "async": true,
            "timeout": 10,
            "statusMessage": "Recording subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/scripts/goal-git.sh harness hook",
            "async": false,
            "timeout": 15,
            "statusMessage": "Recording subagent stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/scripts/goal-git.sh\" harness stop-check 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking goal progress"
          }
        ]
      }
    ]
  }
}
